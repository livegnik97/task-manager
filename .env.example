# Database (credenciales locales de velox-backend, nombre de DB cambiado)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=root
DB_PASSWORD=postgres
DB_DATABASE=task_manager_db

# Redis (opcional, no usado en esta prueba)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=task-manager-access-secret-change-in-production
JWT_REFRESH_SECRET=task-manager-refresh-secret-change-in-production

# App
NODE_ENV=dev
PORT=3000
API_PREFIX=api

# Database mode: true = PostgreSQL, false = in-memory Map (no DB required)
USE_DB=false